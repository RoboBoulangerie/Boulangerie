{% extends "base.html.j2" %}
{% block title %}Review files and tables · {{ kb.name }} · Boulangerie{% endblock %}
{% block description %}Every file and table in the {{ kb.name }} croissant, for its maintainers to check.{% endblock %}
{% block content %}
<p class="crumbs"><a href="{{ root }}index.html">All croissants</a> / <a href="../index.html">{{ kb.name }}</a> / Files and tables</p>

<section class="review-hero">
  <h1>Did we describe your data correctly?</h1>
  <p class="lede">Here is everything the {{ kb.name }} croissant describes: your files, laid out in the folders they
    live in, and the kinds of tables inside them. You know your data best, so you're the judge.</p>
  <div class="questions">
    <a class="question" href="{{ forms['missing-files'] }}">
      <strong>Did we miss any files?</strong><span>Tell us where they are.</span></a>
    <a class="question" href="{{ forms['extra-files'] }}">
      <strong>Is anything here that shouldn't be?</strong><span>Old, internal or test files, for example.</span></a>
    <a class="question" href="{{ forms['download-page'] }}">
      <strong>Is there a better download page?</strong><span>We'll start from there next time.</span></a>
  </div>
</section>

<section class="card review" id="review">
  <div class="tabs" role="tablist">
    <button role="tab" class="tab" id="tab-files" data-tab="files" aria-selected="true">
      Files <span class="count">{{ counts.files|thousands }}</span></button>
    <button role="tab" class="tab" id="tab-tables" data-tab="tables" aria-selected="false">
      Tables <span class="count">{{ counts.families|thousands }} kind{{ "" if counts.families == 1 else "s" }}</span></button>
  </div>
  <p class="muted small" id="tab-help"></p>
  <div class="controls">
    <label class="search"><span class="visually-hidden">Search</span>
      <input id="q" type="search" placeholder="Search names, folders, columns…" autocomplete="off"></label>
    <label class="check"><input type="checkbox" id="look-only"> <span id="look-label">Only ones that need a look</span></label>
  </div>
  <p id="status" class="muted small" aria-live="polite">Loading…</p>
  <div id="view"></div>
  <nav class="pager" aria-label="Pages" id="pager" hidden>
    <button id="prev" class="button button-quiet" type="button">← Previous</button>
    <button id="next" class="button button-quiet" type="button">Next →</button>
  </nav>
</section>

<script>
(function () {
  var PAGE = 50, CHUNK = 100, FILE_LIST = 20;
  var FILE_FORM = {{ forms['file-problem']|tojson }}, TABLE_FORM = {{ forms['table-problem']|tojson }};
  var KB_NAME = {{ kb.name|tojson }};
  var counts = {{ counts|tojson }};
  var state = { tab: location.hash === '#tables' ? 'tables' : 'files', q: '', lookOnly: false, page: 0 };
  var data = null;
  var $ = function (id) { return document.getElementById(id); };
  var SEV = { problem: 'Needs fixing', warning: 'Worth checking', note: 'Nice to have' };
  var ICON = { folder: '📁', archive: '🗜️', group: '🗂️', family: '🗂️',
               formats: '📑', fileset: '🗃️', file: '📄' };

  // ── Small DOM helpers (all text goes in with textContent) ────────────────
  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null) e.textContent = text;
    return e;
  }
  function link(href, text) { var a = el('a', null, text); a.href = href; return a; }
  function size(n) {
    if (!n) return '';
    var units = ['bytes', 'KB', 'MB', 'GB', 'TB'], i = 0;
    while (n >= 1000 && i < units.length - 1) { n /= 1000; i++; }
    return i === 0 ? n + ' bytes' : n.toFixed(1) + ' ' + units[i];
  }
  var PLURALS = { 'kind of table': 'kinds of tables' };
  function plural(n, word) { return n.toLocaleString() + ' ' + (n === 1 ? word : (PLURALS[word] || word + 's')); }
  function lookBadge(n) { return n ? el('span', 'badge badge-warn', n === true ? 'Needs a look' : n.toLocaleString() + ' to look at') : null; }
  function reportLink(form, what, label) {
    var a = link(form + '&item=' + encodeURIComponent(what), label || 'Something wrong with this? Tell us \u2192');
    a.className = 'text-link small';
    var p = el('p'); p.appendChild(a); return p;
  }
  // "a › b › name": folders muted, last part bold.
  function pathLabel(path) {
    var span = el('span', 'path');
    var parts = String(path).split(' › ');
    if (parts.length > 1) span.appendChild(el('span', 'path-folders', parts.slice(0, -1).join(' › ') + ' › '));
    span.appendChild(el('strong', null, parts[parts.length - 1]));
    return span;
  }
  function chips(columns) {
    var box = el('div', 'columns');
    columns.forEach(function (c) {
      var chip = el('span', 'col');
      chip.appendChild(el('code', null, c[0]));
      if (c[1]) chip.appendChild(el('span', 'col-type', c[1]));
      box.appendChild(chip);
    });
    return box;
  }
  // A long list rendered a chunk at a time.
  function chunked(container, items, render, chunk) {
    var shown = 0;
    var more = el('button', 'more', '');
    more.type = 'button';
    function next() {
      items.slice(shown, shown + chunk).forEach(function (it) { container.appendChild(render(it)); });
      shown = Math.min(items.length, shown + chunk);
      if (shown < items.length) {
        more.textContent = 'Show ' + Math.min(chunk, items.length - shown).toLocaleString() + ' more of ' +
          (items.length - shown).toLocaleString();
        container.appendChild(more);
      } else if (more.parentNode) more.parentNode.removeChild(more);
    }
    more.addEventListener('click', function () { more.parentNode.removeChild(more); next(); });
    next();
  }

  // ── What we know about one file ──────────────────────────────────────────
  // Plain names for the croissant properties a file can have.
  var PROPERTY_LABELS = {
    '@type': 'Croissant type', '@id': 'Identifier', name: 'Name', description: 'Description',
    contentUrl: 'Download link', encodingFormat: 'Kind of file', contentSize: 'Size',
    sha256: 'Checksum (SHA-256)', md5: 'Checksum (MD5)', containedIn: 'Inside', includes: 'Files matching',
    excludes: 'Except files matching', sameAs: 'Same content as', dateModified: 'Last modified'
  };
  var PROPERTY_ORDER = ['name', 'description', 'encodingFormat', 'contentSize', 'contentUrl', 'includes', 'excludes',
                        'containedIn', 'dateModified', 'sha256', 'md5', 'sameAs', '@type', '@id'];
  function facts(rows) {
    var dl = el('dl', 'facts');
    rows.forEach(function (r) {
      var dt = el('dt');
      dt.appendChild(document.createTextNode(r[0]));
      if (r[2]) { dt.appendChild(document.createTextNode(' ')); dt.appendChild(el('code', 'prop', r[2])); }
      dl.appendChild(dt);
      var dd = el('dd');
      if (typeof r[1] === 'string') dd.textContent = r[1]; else dd.appendChild(r[1]);
      dl.appendChild(dd);
    });
    return dl;
  }
  function propertyValue(key, value, f) {
    if (Array.isArray(value)) {
      var span = el('span');
      value.forEach(function (v, k) { if (k) span.appendChild(document.createTextNode(', ')); span.appendChild(propertyValue(key, v, f)); });
      return span;
    }
    if (value && typeof value === 'object') {
      if (key === 'containedIn' && value['@id']) return document.createTextNode(f.inside || value['@id']);
      return el('code', null, JSON.stringify(value));
    }
    var text = String(value);
    if (/^(https?|ftp):\/\//.test(text)) return link(text, text);
    if (key === 'encodingFormat' && f.kind && f.kind !== text) return document.createTextNode(text + ' (' + f.kind + ')');
    if (key === 'contentSize' && f.size && f.size !== text) return document.createTextNode(text + ' (' + f.size + ')');
    if (key === 'sha256' || key === 'md5') return el('code', 'checksum', text);
    return document.createTextNode(text);
  }
  function fileDetails(f) {
    var body = el('div', 'item-body');

    // 1. Exactly what the croissant says, with its property names.
    body.appendChild(el('h4', 'facts-heading', 'What the croissant says about this file'));
    var keys = Object.keys(f.entry).sort(function (a, b) {
      var ia = PROPERTY_ORDER.indexOf(a), ib = PROPERTY_ORDER.indexOf(b);
      return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
    });
    var rows = keys.map(function (k) {
      var v = propertyValue(k, f.entry[k], f);
      return [PROPERTY_LABELS[k] || k, v, k];
    });
    if (!f.entry.description) rows.splice(1, 0, ['Description', el('em', 'muted', 'none. If you can tell us what this file is, please use the link below.'), 'description']);
    body.appendChild(facts(rows));

    // 2. What we found out ourselves.
    body.appendChild(el('h4', 'facts-heading', 'What we found'));
    var found = [];
    if (f.link_check) found.push(['Link check', f.link_check]);
    if (f.table_kinds && f.table_kinds.length) {
      var kinds = el('span');
      f.table_kinds.forEach(function (k, n) {
        if (n) kinds.appendChild(document.createTextNode(', '));
        var a = link('#tables', data.families[k].name);
        a.addEventListener('click', function (e) {
          e.preventDefault(); state.tab = 'tables'; state.q = data.families[k].name; $('q').value = state.q;
          state.page = 0; history.replaceState(null, '', '#tables'); render();
        });
        kinds.appendChild(a);
      });
      found.push(['Tables in it', kinds]);
    } else {
      found.push(['Tables in it', f.tabular ? 'None described yet. This file holds a table, so we should list its columns.'
                                            : 'None (it isn\u2019t a table)']);
    }
    body.appendChild(facts(found));
    if (f.look && !f.issues.length) {
      body.appendChild(el('p', 'why', 'Why we flagged this: the pipeline that wrote your croissant wasn\u2019t fully sure about it.'));
    }
    issuesAndDoubts(body, f.issues, f.unsure);
    body.appendChild(reportLink(FILE_FORM, f.path));
    return body;
  }
  function issuesAndDoubts(body, issues, unsure) {
    if (issues.length) {
      var ul = el('ul', 'item-issues');
      issues.forEach(function (i) {
        var li = el('li');
        li.appendChild(el('span', 'sev sev-' + i.severity, SEV[i.severity]));
        li.appendChild(document.createTextNode(' ' + i.title + (i.count > 1 ? ' (' + i.count.toLocaleString() + ' tables)' : '')));
        ul.appendChild(li);
      });
      body.appendChild(ul);
    }
    if (unsure && unsure.length) {
      body.appendChild(el('p', 'small', 'Parts we weren’t sure about:'));
      var u = el('ul', 'unsure');
      unsure.forEach(function (x) {
        var li = el('li');
        li.appendChild(el('strong', null, x.part));
        li.appendChild(document.createTextNode(' = ' + x.value));
        u.appendChild(li);
      });
      body.appendChild(u);
    }
  }
  function fileCard(f) {
    var li = el('li', 'item' + (f.look ? ' item-look' : ''));
    var d = el('details');
    var s = el('summary');
    var head = el('div', 'item-head');
    var badge = lookBadge(f.look); if (badge) head.appendChild(badge);
    head.appendChild(pathLabel(f.path));
    s.appendChild(head);
    s.appendChild(el('span', 'item-meta', [f.group ? 'Group of files' : '', f.kind, f.size].filter(Boolean).join(' · ')));
    d.appendChild(s);
    d.addEventListener('toggle', function once() {
      if (d.open && !d._filled) { d.appendChild(fileDetails(f)); d._filled = true; }
    });
    li.appendChild(d);
    return li;
  }

  // ── Files: the folder tree ───────────────────────────────────────────────
  function nodeMeta(n) {
    var bits = [];
    if (n.type === 'group') bits.push(plural(n.count, n.of === 'files' ? 'file' : 'folder') + ' named like this');
    else if (n.type === 'formats') bits.push((n.formats || []).join(', '));
    else if (n.type !== 'file' && n.type !== 'fileset') bits.push(plural(n.files, 'file'));
    if (n.size) bits.push(size(n.size));
    if ((n.type === 'file' || n.type === 'fileset') && n.file !== undefined) bits.unshift(data.files[n.file].kind);
    return bits.join(' · ');
  }
  function treeNode(n) {
    var li = el('li', 'node node-' + n.type + (n.look ? ' node-look' : ''));
    var d = el('details');
    var s = el('summary');
    s.appendChild(el('span', 'node-icon', ICON[n.type] || ''));
    s.appendChild(el('span', 'node-name', n.name));
    s.appendChild(el('span', 'node-meta', nodeMeta(n)));
    var badge = n.type === 'file' || n.type === 'fileset' ? lookBadge(n.look > 0) : lookBadge(n.look);
    if (badge) s.appendChild(badge);
    d.appendChild(s);
    d.addEventListener('toggle', function () {
      if (!d.open || d._filled) return;
      d._filled = true;
      if (n.file !== undefined) d.appendChild(fileDetails(data.files[n.file]));
      if (n.children && n.children.length) {
        var ul = el('ul', 'tree');
        chunked(ul, n.children, treeNode, CHUNK);
        d.appendChild(ul);
      }
    });
    li.appendChild(d);
    return li;
  }
  function renderTree(view) {
    var root = data.tree;
    var top = el('div', 'tree-root');
    top.appendChild(el('span', 'node-icon', ICON.folder));
    top.appendChild(el('strong', null, root.name || KB_NAME));
    top.appendChild(el('span', 'node-meta', plural(root.files, 'file') + (root.size ? ' · ' + size(root.size) : '')));
    view.appendChild(top);
    var ul = el('ul', 'tree tree-top');
    chunked(ul, root.children, treeNode, CHUNK);
    view.appendChild(ul);
    // Open the first level if it's small, so people see something right away.
    if (root.children.length <= 3) ul.querySelectorAll(':scope > li > details').forEach(function (d) { d.open = true; });
    $('status').textContent = '';
  }

  // ── Tables: families of files, then column layouts ───────────────────────
  function layoutIssues(layout) {
    var seen = {};
    layout.tables.forEach(function (i) {
      data.tables[i].issues.forEach(function (x) {
        var key = x.severity + x.title;
        if (!seen[key]) seen[key] = { severity: x.severity, title: x.title, count: 0 };
        seen[key].count++;
      });
    });
    return Object.keys(seen).map(function (k) { return seen[k]; });
  }
  function layoutUnsure(layout) {
    var out = [];
    layout.tables.slice(0, 5).forEach(function (i) { out = out.concat(data.tables[i].unsure); });
    return out.slice(0, 5);
  }
  // Files that share a layout but disagree on a column's kind of value (guessed from each file's first rows).
  function typeNotes(layout) {
    if (!layout.types_vary || !layout.types_vary.length) return null;
    var box = el('div', 'type-notes');
    box.appendChild(el('p', 'small', 'These files have the same columns, but the kind of value we recorded for some ' +
      'columns differs from file to file. Usually that means a column is mostly numbers with some text, or some files ' +
      'are mostly empty. Please tell us the right kind if you know it.'));
    var ul = el('ul', 'small');
    layout.types_vary.forEach(function (v) {
      var li = el('li');
      li.appendChild(el('code', null, v.column));
      li.appendChild(document.createTextNode(': ' + v.types.map(function (t) {
        return (t[0] || 'unknown') + ' in ' + t[1].toLocaleString();
      }).join(', ')));
      ul.appendChild(li);
    });
    box.appendChild(ul);
    return box;
  }
  function fileList(files) {
    var box = el('div', 'family-files');
    box.appendChild(el('p', 'small muted', files.length === 1 ? 'In this file:' : 'In these ' + files.length.toLocaleString() + ' files:'));
    var ul = el('ul', 'file-list');
    chunked(ul, files, function (f) { var li = el('li'); li.appendChild(pathLabel(f)); return li; }, FILE_LIST);
    box.appendChild(ul);
    return box;
  }
  function familyCard(fam) {
    var li = el('li', 'item' + (fam.look ? ' item-look' : ''));
    var d = el('details');
    var s = el('summary');
    var head = el('div', 'item-head');
    var badge = lookBadge(fam.look); if (badge) head.appendChild(badge);
    head.appendChild(pathLabel(fam.name));
    s.appendChild(head);
    var cols = fam.layouts.length === 1 ? plural(fam.layouts[0].columns.length, 'column')
      : plural(fam.layouts.length, 'column layout');
    s.appendChild(el('span', 'item-meta', plural(fam.files, 'file') + ' · ' + cols));
    d.appendChild(s);
    d.addEventListener('toggle', function () {
      if (!d.open || d._filled) return;
      d._filled = true;
      var body = el('div', 'item-body');
      var description = data.tables[fam.layouts[0].tables[0]].description;
      if (description && fam.tables === 1) body.appendChild(el('p', null, description));
      if (fam.layouts.length === 1) {
        var l = fam.layouts[0];
        body.appendChild(chips(l.columns));
        var notes = typeNotes(l); if (notes) body.appendChild(notes);
        if (l.look && !layoutIssues(l).length) body.appendChild(el('p', 'why', 'Why we flagged this: the pipeline that wrote your croissant wasn’t fully sure about it.'));
        issuesAndDoubts(body, layoutIssues(l), layoutUnsure(l));
        body.appendChild(fileList(l.files));
      } else {
        if (fam.common.length) {
          body.appendChild(el('p', 'small', 'Columns every one of these files has:'));
          body.appendChild(chips(fam.common));
        }
        body.appendChild(el('p', 'small', 'These files come in ' + fam.layouts.length.toLocaleString() +
          ' layouts. Each one below lists only the columns that differ.'));
        var ul = el('ul', 'layouts');
        chunked(ul, fam.layouts.map(function (l, k) { return [l, k]; }), function (pair) {
          var l = pair[0], k = pair[1];
          var li2 = el('li', 'layout');
          var d2 = el('details');
          var s2 = el('summary');
          var b2 = lookBadge(l.look); if (b2) s2.appendChild(b2);
          s2.appendChild(el('strong', null, 'Layout ' + (k + 1)));
          s2.appendChild(el('span', 'node-meta', plural(l.files.length, 'file') + ' · ' +
            (l.extra.length ? 'also has ' + l.extra.slice(0, 4).map(function (c) { return c[0]; }).join(', ') +
              (l.extra.length > 4 ? ' and ' + (l.extra.length - 4) + ' more' : '') : 'only the shared columns')));
          d2.appendChild(s2);
          d2.addEventListener('toggle', function () {
            if (!d2.open || d2._filled) return;
            d2._filled = true;
            var b = el('div', 'item-body');
            if (l.extra.length) b.appendChild(chips(l.extra));
            var n2 = typeNotes(l); if (n2) b.appendChild(n2);
            issuesAndDoubts(b, layoutIssues(l), layoutUnsure(l));
            b.appendChild(fileList(l.files));
            d2.appendChild(b);
          });
          li2.appendChild(d2);
          return li2;
        }, PAGE);
        body.appendChild(ul);
      }
      body.appendChild(reportLink(TABLE_FORM, fam.name, 'Something wrong with these tables? Tell us →'));
      d.appendChild(body);
    });
    li.appendChild(d);
    return li;
  }

  // ── Search and "needs a look": a flat list of matches ────────────────────
  function matches(text) { var q = state.q.trim().toLowerCase(); return !q || text.toLowerCase().indexOf(q) !== -1; }
  function flatFiles() {
    return data.files.filter(function (f) {
      return (!state.lookOnly || f.look) && matches([f.path, f.kind, f.url, f.description].join(' '));
    }).sort(function (a, b) { return a.rank - b.rank; });
  }
  function flatFamilies() {
    return data.families.filter(function (fam) {
      if (state.lookOnly && !fam.look) return false;
      if (!state.q.trim()) return true;
      if (matches(fam.name)) return true;
      return fam.layouts.some(function (l) {
        return l.columns.some(function (c) { return matches(c[0]); }) || l.files.some(matches);
      });
    });
  }
  function renderList(view, items, card, noun) {
    var pages = Math.max(1, Math.ceil(items.length / PAGE));
    state.page = Math.min(state.page, pages - 1);
    var start = state.page * PAGE, shown = items.slice(start, start + PAGE);
    var ul = el('ul', 'items');
    shown.forEach(function (it) { ul.appendChild(card(it)); });
    view.appendChild(ul);
    $('status').textContent = items.length === 0 ? 'Nothing matches.' :
      'Showing ' + (start + 1).toLocaleString() + '–' + (start + shown.length).toLocaleString() + ' of ' + plural(items.length, noun) + '.';
    $('pager').hidden = pages <= 1;
    $('prev').disabled = state.page === 0;
    $('next').disabled = state.page >= pages - 1;
  }

  function render() {
    var view = $('view');
    view.textContent = '';
    $('pager').hidden = true;
    var filtering = state.q.trim() || state.lookOnly;
    if (state.tab === 'files') {
      $('tab-help').textContent = filtering
        ? 'Files that match, the ones we think most need a look first.'
        : 'Your files in the folders they live in. Open a folder to see inside; open a file to see what we say about it.';
      $('look-label').textContent = 'Only files that need a look (' + counts.files_look.toLocaleString() + ')';
      if (filtering) renderList(view, flatFiles(), fileCard, 'file'); else renderTree(view);
    } else {
      $('tab-help').textContent = 'Tables are grouped by the files they come from. Where those files differ in their columns, each layout is listed separately.';
      $('look-label').textContent = 'Only tables that need a look (' + counts.families_look.toLocaleString() + ' kinds)';
      renderList(view, flatFamilies(), familyCard, 'kind of table');
    }
    ['files', 'tables'].forEach(function (t) { $('tab-' + t).setAttribute('aria-selected', String(t === state.tab)); });
  }

  document.querySelectorAll('.tab').forEach(function (b) {
    b.addEventListener('click', function () {
      state.tab = b.dataset.tab; state.page = 0;
      history.replaceState(null, '', '#' + state.tab);
      render();
    });
  });
  $('q').addEventListener('input', function (e) { state.q = e.target.value; state.page = 0; render(); });
  $('look-only').addEventListener('change', function (e) { state.lookOnly = e.target.checked; state.page = 0; render(); });
  $('prev').addEventListener('click', function () { state.page--; render(); $('review').scrollIntoView(); });
  $('next').addEventListener('click', function () { state.page++; render(); $('review').scrollIntoView(); });

  fetch('../review.json')
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (d) { data = d; render(); })
    .catch(function (e) { $('status').textContent = 'Sorry, the list didn’t load (' + e.message + ').'; });
})();
</script>
{% endblock %}
