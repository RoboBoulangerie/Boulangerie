{% extends "base.html.j2" %}
{% block title %}Tables · {{ kb.name }} · Boulangerie{% endblock %}
{% block description %}The kinds of tables in the {{ kb.name }} croissant, for its maintainers to check.{% endblock %}
{% block content %}
<p class="crumbs"><a href="{{ root }}index.html">All croissants</a> / <a href="../index.html">{{ kb.name }}</a> / Tables</p>

<section class="review-hero">
  <h1>The tables in your files</h1>
  <p class="lede">For files that hold tables, we listed the columns so people know what's inside before they
    download. Files with exactly the same columns are grouped as one kind of table. You know your data best, so please
    tell us what we got wrong.</p>
  <p><a href="../index.html#files">← Back to your files</a></p>
</section>

<section class="card review" id="tables">
  <h2>{{ counts.kinds|thousands }} kind{{ "" if counts.kinds == 1 else "s" }} of tables</h2>
  <div id="table-browser" class="browser"></div>
</section>

<script src="{{ root }}static/browse.js"></script>
<script>
  Boulangerie.tables(document.getElementById('table-browser'), {
    url: '../tables.json', tableForm: {{ forms['table-problem']|tojson }}
  });
</script>
{% endblock %}
